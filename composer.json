{
    "name": "yii2-extensions/select2",
    "type": "library",
    "description": "Select2 widgets for Yii2 with ActiveForm, AJAX searches, and native browser assets.",
    "keywords": [
        "yii2",
        "select2",
        "widget",
        "form",
        "dropdown",
        "ajax",
        "jquery"
    ],
    "homepage": "https://github.com/yii2-extensions/select2",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yii2-extensions/select2/issues",
        "source": "https://github.com/yii2-extensions/select2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "php-forge/foxy": "^0.4",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.7",
        "php-forge/support": "^0.1",
        "phpunit/phpunit": "^10.5",
        "roave/infection-static-analysis-plugin": "^1.34",
        "symplify/easy-coding-standard": "^12.1",
        "yii2-extensions/phpstan": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "Yii2\\Extensions\\Select2\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yii2\\Extensions\\Select2\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "foxy": true,
        "skills": {
            "source": ".agents/skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "infection/extension-installer": true,
            "php-forge/foxy": true
        },
        "foxy": {
            "manager": "native"
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "mutation": "./vendor/bin/infection --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100",
        "mutation-static": "php -d memory_limit=-1 ./vendor/bin/infection --initial-tests-php-options='-d memory_limit=-1' --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100 --static-analysis-tool=phpstan --static-analysis-tool-options='--memory-limit=-1'",
        "phpstan": "@static",
        "quality": [
            "actionlint",
            "codespell --config .github/linters/.codespellrc --skip=./.git,./.vscode/*,./composer.lock,./foxy.lock,./runtime/*,./vendor/*,./node_modules/*,./internal/*,./.phpunit.cache/*,./code_coverage/*",
            "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
            "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md' '#vendor/**' '#node_modules/**' '#internal/**' '#runtime/**'",
            "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}' '!runtime/**' '!internal/**'",
            "yamllint -c .github/linters/.yamllint.yml .github"
        ],
        "security": [
            "@zizmor",
            "gitleaks git --config .github/linters/.gitleaks.toml --redact"
        ],
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "test": "@tests",
        "tests": "./vendor/bin/phpunit",
        "zizmor": "zizmor --persona=pedantic .github",
        "ecs-check": "./vendor/bin/ecs check --ansi"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "suggest": {
        "yii2-extensions/bootstrap6": "Bootstrap 6 forms and asset bundles for the `bootstrap-6` Select2 theme.",
        "yiisoft/yii2-bootstrap5": "Bootstrap 5 forms and assets for the `bootstrap-5` Select2 theme.",
        "yiisoft/yii2-jquery": "Required on Yii 22 for ActiveForm client validation; bootstrap yii\\jquery\\Bootstrap."
    }
}
